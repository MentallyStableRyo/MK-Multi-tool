{
  "name": "mk-multitool",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Native video slice downloader for YouTube, Instagram, TikTok, and X — Tauri + Rust + FFmpeg",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite",
    "vite:build": "tsc --noEmit && vite build",
    "vite:preview": "vite preview",
    "tauri": "tauri",
    "setup": "node scripts/gen-icon.mjs && node scripts/fetch-binaries.mjs && node scripts/fetch-model.mjs && node scripts/fetch-whisper.mjs",
    "binaries": "node scripts/fetch-binaries.mjs",
    "model": "node scripts/fetch-model.mjs",
    "whisper": "node scripts/fetch-whisper.mjs",
    "binaries:mac": "node scripts/fetch-binaries.mjs --all-mac",
    "build:mac": "tauri build --target aarch64-apple-darwin",
    "build:mac-intel": "tauri build --target x86_64-apple-darwin",
    "build:mac-universal": "tauri build --target universal-apple-darwin",
    "icon": "node scripts/gen-icon.mjs && tauri icon app-icon.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "onnxruntime-web": "^1.22.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
